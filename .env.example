# Added during the database/auth milestone.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated household emails permitted to request a Houser sign-in link.
HOUSER_ALLOWED_EMAILS=owner@example.com,household-member@example.com

# Server-only. Never expose this in browser code or commit a populated value.
SUPABASE_SERVICE_ROLE_KEY=

# Added during document extraction; keep blank for the manual POC.
OPENAI_API_KEY=

# Optional Playwright account. Use a dedicated non-production household whose
# records may be created and dismissed by the end-to-end suite.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_BASE_URL=http://127.0.0.1:3100
